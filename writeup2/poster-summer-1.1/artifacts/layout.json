  },
  {
    "kind": "text",
    "x": 8.1,
    "y": 13.056388888888888,
    "w": 3.65,
    "h": 3.2777777777777777,
    "text": "Washington spans coastal sites, Cascade mountains, and a drier east. We ask whether two specialists can learn distinct soil responses in these settings. Each station holdout tests how well these patterns carry to a new site.",
    "lines": [
      "Washington spans coastal",
      "sites, Cascade mountains,",
      "and a drier east. We ask",
      "whether two specialists",
      "can learn distinct soil",
      "responses in these",
      "settings. Each station",
      "holdout tests how well",
      "these patterns carry to a",
      "new site."
    ],
    "size": 20,
    "color": "#536875",
    "bold": false,
    "align": "left",
    "name": "Study-area interpretation",
    "required_height": 3.2777777777777777
