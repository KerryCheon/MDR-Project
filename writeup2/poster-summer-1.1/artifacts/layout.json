  {
    "kind": "text",
    "x": 0.75,
    "y": 4.19,
    "w": 11.0,
    "h": 0.4425,
    "text": "Why soil moisture estimation?",
    "lines": [
      "Why soil moisture estimation?"
    ],
    "size": 27,
    "color": "#C00000",
    "bold": true,
    "align": "left",
    "name": "",
    "required_height": 0.4425
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 4.8525,
    "w": 11.0,
    "h": 1.442222222222222,
    "text": "Soil moisture regulates agricultural productivity and drought resilience, making daily estimates vital for water management. High-resolution modeling tracks moisture recharge and drydown dynamics, particularly across regions lacking direct measurement infrastructure.",
    "lines": [
      "Soil moisture regulates agricultural productivity and drought resilience,",
      "making daily estimates vital for water management. High-resolution",
      "modeling tracks moisture recharge and drydown dynamics, particularly",
      "across regions lacking direct measurement infrastructure."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.442222222222222
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 6.414722222222222,
    "w": 11.0,
    "h": 1.8027777777777776,
    "text": "While in-situ ground sensors offer accurate readings, they exist only at limited monitoring sites. Satellite observations span broader regions but remain intermittent with frequent data gaps. To generate daily estimates, multi-source modeling combines satellite, weather, and site data, extending an established pipeline and global XGBoost baseline.",
    "lines": [
      "While in-situ ground sensors offer accurate readings, they exist only at",
      "limited monitoring sites. Satellite observations span broader regions",
      "but remain intermittent with frequent data gaps. To generate daily",
      "estimates, multi-source modeling combines satellite, weather, and site",
      "data, extending an established pipeline and global XGBoost baseline."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.8027777777777776
  },
