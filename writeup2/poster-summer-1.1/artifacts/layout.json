  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 16.495833333333334,
    "w": 11.0,
    "h": 0.6555555555555554,
    "text": "Figure 1. Seven Washington training stations and their assigned clusters. Colors designate cluster regimes, with no geographic boundaries implied.",
    "lines": [
      "Figure 1. Seven Washington training stations and their assigned clusters.",
      "Colors designate cluster regimes, with no geographic boundaries implied."
    ],
    "size": 20,
    "color": "#536875",
