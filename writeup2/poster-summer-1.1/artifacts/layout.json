    "size": 24,
    "color": "#202B35",
    "bold": true,
    "align": "left",
    "name": "",
    "required_height": 0.7866666666666666
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 10.004166666666666,
    "w": 11.0,
    "h": 1.0816666666666666,
    "text": "Our comparison uses the same evaluation conditions for both models. For known stations, we fix a single specialist; tests at new sites examine how missing satellite inputs affect assignment.",
    "lines": [
      "Our comparison uses the same evaluation conditions for both models.",
