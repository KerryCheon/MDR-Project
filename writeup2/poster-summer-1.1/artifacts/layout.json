  {
    "kind": "text",
    "x": 0.97,
    "y": 8.887500000000001,
    "w": 10.56,
    "h": 0.7866666666666666,
    "text": "Can two specialists improve estimates across Washington's contrasting conditions?",
    "lines": [
      "Can two specialists improve estimates across",
      "Washington's contrasting conditions?"
    ],
    "size": 24,
    "color": "#202B35",
    "bold": true,
    "align": "left",
    "name": "",
    "required_height": 0.7866666666666666
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 10.004166666666666,
    "w": 11.0,
    "h": 1.0816666666666666,
    "text": "Both models are compared under identical benchmarks. For known stations, we assign a fixed specialist; tests at new sites evaluate dynamic routing under missing satellite inputs.",
    "lines": [
      "Both models are compared under identical benchmarks. For known",
      "stations, we assign a fixed specialist; tests at new sites evaluate",
      "dynamic routing under missing satellite inputs."
