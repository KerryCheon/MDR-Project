  {
    "kind": "text",
    "x": 0.75,
    "y": 4.19,
    "w": 11.0,
    "h": 0.4425,
    "text": "Why soil moisture estimation?",
    "lines": [
      "Why soil moisture estimation?"
    ],
    "size": 27,
    "color": "#C00000",
    "bold": true,
    "align": "left",
    "name": "",
    "required_height": 0.4425
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 4.8525,
    "w": 11.0,
    "h": 1.442222222222222,
    "text": "Soil moisture describes water stored near the land surface. It informs irrigation, drought monitoring, and our understanding of water availability. Estimates help us follow rainfall responses and drying where direct measurements are sparse.",
    "lines": [
      "Soil moisture describes water stored near the land surface. It informs",
      "irrigation, drought monitoring, and our understanding of water",
      "availability. Estimates help us follow rainfall responses and drying",
      "where direct measurements are sparse."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.442222222222222
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 6.414722222222222,
    "w": 11.0,
    "h": 1.8027777777777776,
    "text": "Ground sensors measure local conditions; satellites offer broader coverage, but leave gaps between observations and missing retrievals. Our project combines satellite, weather, and site information for daily estimates. Earlier work established this pipeline and a single global XGBoost predictor.",
    "lines": [
      "Ground sensors measure local conditions; satellites offer broader",
      "coverage, but leave gaps between observations and missing retrievals.",
      "Our project combines satellite, weather, and site information for daily",
      "estimates. Earlier work established this pipeline and a single global",
      "XGBoost predictor."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.8027777777777776
  },
