    "name": "",
    "required_height": 0.3605555555555555
  },
  {
    "kind": "text",
    "x": 8.1,
    "y": 12.695833333333333,
    "w": 3.65,
    "h": 3.2777777777777777,
    "text": "Stations span coastal areas, the Cascade mountains, and arid eastern Washington, capturing contrasting hydroclimatic regimes. Leave-one-station-out evaluations test model generalization across unseen microclimates.",
    "lines": [
      "Stations span coastal",
      "areas, the Cascade",
      "mountains, and arid",
      "eastern Washington,",
      "capturing contrasting",
      "hydroclimatic regimes.",
      "Leave-one-station-out",
      "evaluations test model",
      "generalization across",
