  {
    "kind": "text",
    "x": 0.75,
    "y": 4.19,
    "w": 11.0,
    "h": 0.4425,
    "text": "Why soil moisture estimation?",
    "lines": [
      "Why soil moisture estimation?"
    ],
    "size": 27,
    "color": "#C00000",
    "bold": true,
    "align": "left",
    "name": "",
    "required_height": 0.4425
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 4.8525,
    "w": 11.0,
    "h": 1.442222222222222,
    "text": "Soil moisture is the amount of water held in soil. Daily estimates help with irrigation planning and drought monitoring. They show how moisture changes after rain and during dry periods, including places with few direct measurements.",
    "lines": [
      "Soil moisture is the amount of water held in soil. Daily estimates help",
      "with irrigation planning and drought monitoring. They show how",
      "moisture changes after rain and during dry periods, including places",
      "with few direct measurements."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.442222222222222
  },
  {
    "kind": "text",
    "x": 0.75,
    "y": 6.414722222222222,
    "w": 11.0,
    "h": 1.8027777777777776,
    "text": "Ground sensors measure moisture at individual sites. Satellite observations cover larger areas but are intermittent, with some retrievals missing. We combine satellite, weather, and site data for daily estimates. Earlier work produced the pipeline and a global XGBoost model.",
    "lines": [
      "Ground sensors measure moisture at individual sites. Satellite",
      "observations cover larger areas but are intermittent, with some",
      "retrievals missing. We combine satellite, weather, and site data for",
      "daily estimates. Earlier work produced the pipeline and a global",
      "XGBoost model."
    ],
    "size": 22,
    "color": "#202B35",
    "bold": false,
    "align": "left",
    "name": "",
    "required_height": 1.8027777777777776
  },
