{
  "data": {
    "target": "soil_moisture_5cm",
    "splits": {
      "train": "data/splits/derived_8.2/train.csv",
      "val": "data/splits/derived_8.2/val.csv",
      "test": "data/splits/derived_8.2/test.csv"
    },
    "time_col": "date",
    "id_cols": [
      "station_id"
    ],
    "drop_cols": [
      "station_id",
      "date"
    ]
  },
  "selection": {
    "top_k": 50,
    "stability_n_boot": 100,
    "stages": [
      {
        "kind": "mi",
        "k": 300
      },
      {
        "kind": "elasticnet",
        "k": 60
      },
      {
        "kind": "stability",
        "min_freq": 0.0
      }
    ]
  },
  "models": [
    {
      "kind": "linear"
    },
    {
      "kind": "xgb"
    },
    {
      "kind": "rf"
    }
  ],
  "scoring": {
    "score_weights": {
      "mean_r2": 1.0,
      "std_r2": -0.5,
      "gap": -0.2,
      "k_penalty": -0.001
    }
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "log_to_file": true,
    "runs_subdir": "logs",
    "file_name": "pipeline_feat.log",
    "max_bytes": 10485760,
    "backup_count": 5,
    "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    "datefmt": "%Y-%m-%d %H:%M:%S"
  },
  "_meta": {
    "config_path": "C:\\Users\\pan\\Documents\\GitHub\\MDR-Project\\notebooks\\experiment\\derived_8.2-feature-selection\\config_v3.yaml"
  }
}